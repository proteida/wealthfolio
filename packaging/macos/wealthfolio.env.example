# wealthfolio.env — external runtime environment for Wealthfolio (macOS).
#
# INSTALL: copy this file to
#   ~/Library/Application Support/com.teymz.wealthfolio/wealthfolio.env
# then uncomment and edit what you need, and fully restart the app.
# That location is outside the .app bundle, so it survives app updates.
#
# RULES: process env > CWD .env > this file > baked-in values > defaults.
# A missing file is fine; a malformed line aborts startup naming file:line.
# Only WF_*, CONNECT_* and RUST_LOG keys are applied. Values are read once
# at startup — editing requires an app restart. Keep the real file private:
#   chmod 600 ~/Library/Application Support/com.teymz.wealthfolio/wealthfolio.env
# Never commit the real file. See docs/runtime-env.md.

# Server listen address (self-host / server binary).
# WF_LISTEN_ADDR=127.0.0.1:8088

# Server database (defaults to ./db/app.db next to the working directory).
# WF_DB_PATH=/absolute/path/to/app.db

# Server secret: exactly one of these. Generate with e.g.
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# WF_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
# WF_SECRET_KEY_FILE=/absolute/path/to/secret.txt

# Desktop Connect endpoints (override the baked-in values, no rebuild needed).
# CONNECT_AUTH_URL=https://auth.wealthfolio.app
# CONNECT_AUTH_PUBLISHABLE_KEY=
# CONNECT_API_URL=https://api.wealthfolio.app

# Debug logging of resolved env sources (keys only, never values).
# RUST_LOG=debug
